{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "property_type": {
      "type": "string",
      "enum": [
        "Apartment",
        "Condo",
        "House"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "street_address": {
      "type": "string",
      "minLength": 3
    },
    "city": {
      "type": "string",
      "minLength": 2
    },
    "state": {
      "type": "string",
      "const": "CA"
    },
    "zip_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.5
    },
    "square_feet": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "parking",
          "laundry",
          "balcony",
          "air_conditioning",
          "pool",
          "gym"
        ]
      }
    },
    "local_sponsors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "image_path": {
      "type": "string",
      "enum": [
        "/properties/apartment.jpg",
        "/properties/condo.jpg",
        "/properties/house.jpg"
      ]
    },
    "image_alt_text": {
      "type": "string",
      "minLength": 10
    }
  },
  "required": [
    "property_id",
    "title",
    "property_type",
    "description",
    "street_address",
    "city",
    "state",
    "zip_code",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "amenities",
    "local_sponsors",
    "image_path",
    "image_alt_text"
  ],
  "additionalProperties": false
}
